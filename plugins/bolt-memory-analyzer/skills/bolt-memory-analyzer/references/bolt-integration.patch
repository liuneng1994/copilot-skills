+  if (allocation.empty()) {
+    return;
+  }
+  for (int i = 0; i < allocation.numRuns(); i++) {
+    const auto run = allocation.runAt(i);
+    MemoryTraceRecorder::recordAlloc(poolName, run.data(), run.numBytes());
+  }
